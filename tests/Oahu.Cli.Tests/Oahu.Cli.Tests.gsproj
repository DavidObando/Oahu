<Project Sdk="Gsharp.NET.Sdk/0.2.74">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Oahu.Cli.Tests</RootNamespace>
    <AssemblyName>Oahu.Cli.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Spectre.Console.Testing" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oahu.Cli\Oahu.Cli.csproj" />
    <ProjectReference Include="..\..\src\Oahu.Cli.App\Oahu.Cli.App.csproj" />
    <ProjectReference Include="..\..\src\Oahu.Cli.Tui\Oahu.Cli.Tui.csproj" />
    <ProjectReference Include="..\..\src\Oahu.Cli.Server\Oahu.Cli.Server.csproj" />
  </ItemGroup>

</Project>
