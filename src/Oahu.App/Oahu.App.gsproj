<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk/0.4.591">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Oahu.App.Avalonia</RootNamespace>
    <AssemblyName>Oahu</AssemblyName>
    <ApplicationIcon>Resources\audio.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <NoWarn>$(NoWarn);CA1416;IL2026;IL2037;IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Pin to patched version to address NU1903 (GHSA-xrw6-gwf8-vvr9 / CVE-2026-39959); pulled in transitively by Avalonia.Desktop on Linux. -->
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Oahu.Foundation/Oahu.Foundation.gsproj" />
    <ProjectReference Include="../Oahu.Data/Oahu.Data.gsproj" />
    <ProjectReference Include="../Oahu.Core/Oahu.Core.gsproj" />
    <ProjectReference Include="../Oahu.SystemManagement/Oahu.SystemManagement.gsproj" />
    <ProjectReference Include="../Oahu.UI/Oahu.UI.gsproj" />
  </ItemGroup>

</Project>
