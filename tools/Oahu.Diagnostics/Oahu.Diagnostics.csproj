<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Oahu.Diagnostics</RootNamespace>
    <AssemblyName>oahu-diag</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Suppress style/doc warnings inherited from Directory.Build.props -->
    <NoWarn>$(NoWarn);CS1591;SA0001;SA1600;SA1601;SA1602;SA1611;SA1615;SA1623;SA1629;SA1633;SA1652;SA1201;SA1202;SA1502;SA1513;SA1515;SA1516</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oahu.Data\Oahu.Data.csproj" />
    <ProjectReference Include="..\..\src\Oahu.Decrypt\Oahu.Decrypt.csproj" />
  </ItemGroup>

</Project>
